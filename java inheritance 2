import java.io.*;
import java.util.*;

class Arithmetic {
    int add(int a, int b) {
        return a + b;
    }
}

class Adder extends Arithmetic {
}

public class Solution {

    public static void main(String []args) {
        // Create a new Adder object
        Adder a = new Adder();
        
        // Print the name of the superclass that Adder inherits from
        System.out.println("My superclass is: " + a.getClass().getSuperclass().getName());    
        
        // Print the result of 3 calls to Adder's `add(int, int)` method as permitted by inheritance
        System.out.print(a.add(10,32) + " " + a.add(10,3) + " " + a.add(10,10) + "\n");
    }
}
